{
  "name": "restaurant-xr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Application WebXR immersive de réservation de restaurant (projet SUP'COM)",
  "scripts": {
    "dev": "python -m http.server 8000",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.mjs\" \"*.html\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.mjs\" \"*.html\"",
    "check:headers": "node scripts/check-headers.mjs",
    "verify": "npm run check:headers && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "prettier": "^3.3.3"
  }
}
